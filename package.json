{
  "name": "digital-card",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22 <25" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:prepare": "node scripts/migrate.mjs && prisma db seed",
    "start": "pnpm db:prepare && node dist/src/main.js",
    "test": "node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.2.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.0",
    "dataloader": "^2.2.3",
    "dotenv": "^17.2.0",
    "graphql": "^16.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^24.0.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
